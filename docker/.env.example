# Параметры LLM (поддерживаются Groq, OpenRouter, OpenAI, Ollama через LiteLLM)
# При пустом LLM_API_KEY ассистент автоматически работает в безопасном детерминированном fallback-режиме
LLM_API_KEY=
LLM_MODEL=groq/openai/gpt-oss-120b
# LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
LLM_NUM_RETRIES=2

# Нейросетная озвучка ответов (edge-tts, 5 голосов: baya, kseniya, xenia, aidar, eugene)
SPEECH_ENABLED=true

# Лимиты аутентификации (повышены по умолчанию для Docker-сети)
AUTH_REGISTER_MAX_PER_IP=100
AUTH_LOGIN_MAX_PER_IP=120
AUTH_COOKIE_SECURE=false
